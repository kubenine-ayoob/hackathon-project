aws_region        = "us-east-1"
environment       = "prod"
owner_name        = "platform"
name_prefix       = "stacknine-prod"
github_repository = "kubenine/stacknine"
github_branch     = "main"

tfstate_bucket = "stacknine-prod-tfstate"
tflock_table   = "stacknine-prod-tflock"

vpc_cidr = "10.40.0.0/16"
az_count = 3

db_instance_class        = "db.t4g.medium"
db_allocated_storage     = 100
db_max_allocated_storage = 500
db_backup_retention_days = 14
db_deletion_protection   = true
db_skip_final_snapshot   = false
db_multi_az              = true

main_backend_desired_count = 3
sidecar_desired_count      = 2

alarm_email     = "ops@example.com"
enable_ecs_exec = false

image_tags = {
  main-backend = "REPLACE_WITH_GIT_SHA"
  extractor    = "REPLACE_WITH_GIT_SHA"
  parser       = "REPLACE_WITH_GIT_SHA"
}
